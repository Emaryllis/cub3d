Language: Cpp
AlignOperands: true
BreakBeforeBraces: Allman
ColumnLimit: 80
IncludeCategories:
  - Regex: '^<.*'
    Priority: 1
  - Regex: '^".*'
    Priority: 2
  - Regex: '.*'
    Priority: 3
IncludeIsMainRegex: '([-_](test|unittest))?$'
IndentWidth: 4
InsertNewlineAtEOF: true
MacroBlockBegin: ''
MacroBlockEnd: ''
MaxEmptyLinesToKeep: 1
NamespaceIndentation: All
PointerAlignment: Right
SpaceInEmptyParentheses: false
SpacesInAngles: false
TabWidth: 4
UseTab: Always